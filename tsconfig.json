{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./",
    "composite": true,
    "removeComments": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["packages/backend/src/*", "packages/frontend/src/*"]
    },
    "typeRoots": [
      "./node_modules/@types",
      "./packages/backend/node_modules/@types"
    ]
  },
  "exclude": ["node_modules", "dist"]
}
