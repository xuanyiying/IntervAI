# Server Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:5173
BACKUP_DIR=./backups

# Database Configuration
# For local development with docker-compose:
DATABASE_URL=postgresql://resume_user:resume_password@localhost:5432/interview_ai?schema=public
# For production, use your actual database credentials

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Security Configuration
ENCRYPTION_KEY=your-super-secret-encryption-key-here

# OAuth Configuration
# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:3000/api/v1/auth/github/callback

# Payment（支付宝 / 微信支付，一次性收款，金额以服务端计划目录为准）
# 支付宝电脑网站支付（密钥模式），EE 版启用
ALIPAY_APP_ID=
# 应用私钥（PKCS8，不含 BEGIN/END 行）
ALIPAY_PRIVATE_KEY=
# 支付宝公钥（不含 BEGIN/END 行）
ALIPAY_ALIPAY_PUBLIC_KEY=
# 可选，默认正式网关；沙箱为 https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_GATEWAY=

# 微信支付 Native 扫码（APIv3），EE 版启用
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
# 商户 API 证书序列号
WECHAT_PAY_SERIAL_NO=
# 商户 API 私钥 apiclient_key.pem（原文或 \n 转义内容，也可传文件路径）
WECHAT_PAY_PRIVATE_KEY=
# APIv3 密钥（32 位）
WECHAT_PAY_APIV3_KEY=

# 支付回调后端公网基址（拼接 notify_url，需公网可达；缺省 http://localhost:3000/api/v1）
PAYMENT_NOTIFY_BASE_URL=

# AI Model Configuration
# Format: "provider:model", provider must exist in PROVIDER_BASE_URLS
AI_MODEL=deepseek:deepseek-chat
AI_EMBEDDING_MODEL=siliconcloud:BAAI/bge-m3

# AI Provider API Keys
# OpenAI
OPENAI_API_KEY=your-openai-api-key

# DeepSeek
DEEPSEEK_API_KEY=your-deepseek-api-key

# Qwen (Alibaba)
QWEN_API_KEY=your-qwen-api-key

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key

# SiliconFlow
SILICONCLOUD_API_KEY=your-siliconcloud-api-key

# OpenRouter
OPENROUTER_API_KEY=your-openrouter-api-key

# Voice / Realtime Interview (Alibaba DashScope)
# Enables paraformer ASR, cosyvoice TTS and qwen-audio realtime voice calls.
DASHSCOPE_API_KEY=your-dashscope-api-key
# Qwen-Audio realtime engine (end-to-end voice dialog)
QWEN_REALTIME_AUDIO_MODEL=qwen-audio-3.1-realtime-plus
QWEN_REALTIME_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
QWEN_REALTIME_VOICE=longanqian_v3.1
# Assist-mode engine selection: auto (realtime preferred, ASR fallback) | realtime | pipeline
REALTIME_INTERVIEW_ENGINE=auto
