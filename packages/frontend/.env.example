# Root environment variables (if needed)
NODE_ENV=development

# Backend API URL (for API calls via axios)
VITE_API_BASE_URL=http://localhost:3000/api/v1

# 必须与后端 APP_EDITION 一致：oss 时不注册 /pricing、/subscription 等 EE 路由。
# 留空或不设置会默认启用 EE 路由，OSS 部署下这些页面会调用不存在的 /payments/* 接口。
VITE_APP_EDITION=oss

# Vite dev proxy target for /api and /socket.io (defaults to http://localhost:3000)
VITE_PROXY_TARGET=http://localhost:3000

# Backend Server URL (for OAuth redirects that need full URL)
VITE_BACKEND_URL=http://localhost:3000

# OAuth Configuration
VITE_GOOGLE_OAUTH_ENABLED=true
VITE_GITHUB_OAUTH_ENABLED=true


# Stripe Configuration
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
VITE_STRIPE_PRICE_PRO_MONTHLY=price_...
VITE_STRIPE_PRICE_PRO_YEARLY=price_...
VITE_STRIPE_PRICE_ENTERPRISE_MONTHLY=price_...
VITE_STRIPE_PRICE_ENTERPRISE_YEARLY=price_...

# Paddle Configuration
VITE_PADDLE_CLIENT_TOKEN=test_...
VITE_PADDLE_PRICE_PRO_MONTHLY=pri_...
VITE_PADDLE_PRICE_PRO_YEARLY=pri_...
VITE_PADDLE_PRICE_ENTERPRISE_MONTHLY=pri_...
VITE_PADDLE_PRICE_ENTERPRISE_YEARLY=pri_...